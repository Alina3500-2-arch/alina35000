/**
 * Создаёт Google Форму «Бриф на сайт» со всеми вопросами.
 *
 * Как запустить:
 *  1. script.google.com → Новый проект
 *  2. Удалить содержимое редактора, вставить этот файл целиком
 *  3. Сохранить, нажать «Выполнить»
 *  4. Разрешить доступ (предупреждение о непроверенном приложении — нормально,
 *     это ваш собственный скрипт): Дополнительные настройки → Перейти к проекту → Разрешить
 *  5. Ссылки на форму появятся в «Журнале выполнения»
 *
 * С телефона работает при включённой в браузере «Версии для ПК».
 */
function createBrief() {
  var form = FormApp.create('Бриф на сайт — PERFECT TON');
  form.setDescription(
    'Чтобы предложение было точным, а не «примерно», заполните, пожалуйста, анкету. ' +
    'Это 15–20 минут. Чем подробнее ответите, тем меньше правок будет потом ' +
    'и тем точнее посчитаем срок и стоимость. На часть вопросов можно отвечать одним словом.'
  );
  form.setProgressBar(true);

  function sec(t) { form.addPageBreakItem().setTitle(t); }
  function q(t, req) { form.addParagraphTextItem().setTitle(t).setRequired(!!req); }
  function one(t, opts, req) {
    form.addMultipleChoiceItem().setTitle(t).setChoiceValues(opts).setRequired(!!req);
  }

  sec('1. О салоне');
  q('Полное название, как оно должно писаться на сайте', true);
  q('Адрес, ориентиры, парковка');
  q('Сколько лет работаете');
  q('Сколько мастеров в команде');
  q('Режим работы');

  sec('2. Услуги');
  q('Перечислите направления работы', true);
  q('Какие три услуги приносят больше всего денег', true);
  q('Какие услуги хотите продавать активнее, чем сейчас');
  q('Прайс — приложите ссылкой или перечислите основные позиции');

  sec('3. Клиенты');
  q('Кто ваши клиентки: возраст, район, чем занимаются');
  q('Средний чек за визит');
  q('Сколько примерно клиенток в месяц');
  q('Какая доля возвращается повторно');
  q('Откуда приходят сейчас и примерно в каких долях: карты, сарафан, соцсети, реклама');

  sec('4. Что должен делать сайт');
  one('Главное действие, которое должен совершить посетитель — выберите одно',
      ['Онлайн-запись', 'Звонок', 'Сообщение в мессенджер', 'Заявка через форму'], true);
  q('Что ещё важно показать: акции, сертификаты, галерея работ, отзывы');
  q('Используете yclients или другую систему записи? Нужна ли интеграция');
  q('Нужны ли отдельные страницы под рекламу');

  sec('5. Чем вы отличаетесь');
  q('Три причины, по которым клиентка выбирает вас, а не салон рядом', true);
  q('Что вы делаете лучше всех');
  q('Что чаще всего спрашивают перед записью — сомнения, страхи, возражения');
  q('Чего на сайте быть не должно ни при каких условиях');

  sec('6. Ориентиры');
  q('Два-три салона, которых считаете сильными');
  q('Два-три сайта, которые нравятся — не обязательно салоны. Что именно нравится');
  q('Сайты, которые не нравятся, и чем');

  sec('7. Материалы');
  q('Логотип: есть, в каком формате');
  q('Фирменные цвета и шрифты');
  q('Фотографии салона: есть ли профессиональные, сколько');
  q('Фотографии работ: сколько, какого качества');
  q('Фотографии мастеров');
  one('Тексты', ['Пишем сами', 'Нужны от вас', 'Часть сами, часть от вас']);
  q('Отзывы: откуда берём — карты, скриншоты, свои');

  sec('8. Техническое');
  q('Домен есть? Какой, на кого зарегистрирован');
  q('Хостинг есть?');
  q('Есть ли действующий сайт или лендинг');
  q('Кто будет вносить правки после запуска');

  sec('9. Сроки');
  q('К какой дате нужен сайт и почему именно к ней', true);
  q('Есть ли привязка к сезону, акции, открытию');

  sec('10. Организационное');
  q('Как удобнее общаться и в какое время');
  q('Работали раньше с подрядчиками по сайтам? Что не устроило');
  q('Структуру сайта вы уже обсуждали с предыдущим подрядчиком. ' +
    'На какой бюджет и срок тогда ориентировались и почему не сложилось?');
  one('Закладывали ли вы бюджет на сайт?',
      ['до 25 000 ₽', '25 000 – 40 000 ₽', '40 000 – 60 000 ₽',
       'больше 60 000 ₽', 'ещё не считала'], true);

  Logger.log('Ссылка для клиента: ' + form.getPublishedUrl());
  Logger.log('Ссылка на редактирование: ' + form.getEditUrl());
}
